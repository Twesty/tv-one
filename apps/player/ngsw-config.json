{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "player-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
              "/index.html",
          "/*.css",
          "/*.js",
          "/assets/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "player-directory",
      "urls": ["/api/player/venues", "/api/player/venues/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "1h",
        "timeout": "3s"
      }
    }
  ]
}
